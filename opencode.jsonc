{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "headroom": {
      "api": "http://localhost:8787/v1",
      "env": ["DEEPSEEK_API_KEY", "ANTHROPIC_API_KEY", "OPENAI_API_KEY"],
      "models": {
        "deepseek-v4-flash": {
          "id": "deepseek-chat",
          "name": "DeepSeek V4 Flash",
          "reasoning": true
        },
        "deepseek-v4-pro": {
          "id": "deepseek-chat",
          "name": "DeepSeek V4 Pro",
          "reasoning": true
        },
        "claude-sonnet-4-6": {
          "id": "claude-sonnet-4-6",
          "name": "Claude Sonnet 4.6"
        },
        "claude-opus-4-6": {
          "id": "claude-opus-4-6",
          "name": "Claude Opus 4.6"
        },
        "gpt-4o": {
          "id": "gpt-4o",
          "name": "GPT-4o"
        },
        "gpt-4.1": {
          "id": "gpt-4.1",
          "name": "GPT-4.1"
        }
      }
    }
  },
  "model": "headroom/deepseek-v4-flash"
}
